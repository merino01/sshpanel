{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Panel",
  "version": "0.8.0",
  "identifier": "io.github.merino01.sshpanel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSH Panel",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "create": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sshpanel"
        ],
        "name": "Perfil de SSH Panel",
        "description": "Perfil de SSH Panel",
        "role": "Editor",
        "mimeType": "application/x-sshpanel",
        "exportedType": {
          "identifier": "io.github.merino01.sshpanel.profile",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/app.desktop",
        "files": {
          "/usr/share/mime/packages/io.github.merino01.sshpanel.xml": "linux/mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/app.desktop",
        "files": {
          "/usr/share/mime/packages/io.github.merino01.sshpanel.xml": "linux/mime.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBODM5NTkyRTM3MEY4RTMKUldUaitIRGprcFdEdXVYdU9XWGVZcHJDUlh1KzJDOW42bWowd0MxVWh0QXFvVTZucEt3Y29uM3oK",
      "endpoints": [
        "https://github.com/merino01/sshpanel/releases/latest/download/latest.json"
      ]
    }
  }
}
