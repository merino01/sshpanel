{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBDesp Panel",
  "version": "0.1.0",
  "identifier": "com.dbdesp.panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DBDesp Panel",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dbdesp"
        ],
        "name": "Perfil de DBDesp Panel",
        "description": "Perfil de DBDesp Panel",
        "role": "Editor",
        "mimeType": "application/x-dbdesp",
        "exportedType": {
          "identifier": "com.dbdesp.panel.profile",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/app.desktop",
        "files": {
          "/usr/share/mime/packages/com.dbdesp.panel.xml": "linux/mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/app.desktop",
        "files": {
          "/usr/share/mime/packages/com.dbdesp.panel.xml": "linux/mime.xml"
        }
      }
    }
  }
}
